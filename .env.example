# Browser (public)
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.c-x.region.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://ep-xxx.apirest.c-x.region.aws.neon.tech/neondb/rest/v1

# Server (api/ functions and db scripts) — never exposed to the browser
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.c-x.region.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.c-x.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
S3_ENDPOINT=https://br-xxx.storage.c-x.region.aws.neon.tech
S3_REGION=us-east-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
